{
  "name": "ilac-siparis-takip",
  "productName": "İlaç Sipariş Takip",
  "version": "1.0.0",
  "description": "İlaç sipariş / bütçe / fiili karşılaştırma ve takip programı",
  "author": "İlaç Sipariş Takip",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "exceljs": "4.4.0",
    "xlsx-js-style": "1.2.0"
  },
  "build": {
    "appId": "tr.ilac.siparistakip",
    "productName": "İlaç Sipariş Takip",
    "copyright": "İlaç Sipariş Takip",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "store.js", "app/**/*", "build/icon.png", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "İlaç Sipariş Takip",
      "deleteAppDataOnUninstall": false,
      "language": "1055"
    },
    "portable": { "artifactName": "IlacSiparisTakip-Tasinabilir-${version}.exe" },
    "mac": { "icon": "build/icon.icns", "category": "public.app-category.business", "target": ["dmg"] },
    "linux": { "icon": "build/icon.png", "category": "Office", "target": ["AppImage"] },
    "artifactName": "IlacSiparisTakip-Kurulum-${version}.${ext}"
  }
}
